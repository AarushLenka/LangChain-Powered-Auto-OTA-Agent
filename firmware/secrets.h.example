// secrets.h.example
// Copy this file to secrets.h and fill in your actual values.
// secrets.h is ignored by .gitignore — NEVER commit it.

#ifndef SECRETS_H
#define SECRETS_H

// WiFi credentials
#define WIFI_SSID "your_ssid_here"
#define WIFI_PASSWORD "your_password_here"

// OTA server address (laptop running FastAPI)
#define OTA_SERVER_IP "192.168.1.100"
#define OTA_SERVER_PORT 5001
#define OTA_BASE_URL "http://192.168.1.100:5001"

// Optional: API key for firmware endpoints (if added later)
// #define OTA_API_KEY "your_api_key_here"

#endif // SECRETS_H
